{
  "name": "comic-stack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "npm run write:env -s && ng build",
    "build:production": "npm run write:env -s && ng build --configuration=production  --base-href=/comic-stack/",
    "deploy": "ng deploy --base-href=https://markostruna.github.io/comic-stack/",
    "start": "npm run write:env -s && ng serve --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "ng lint && stylelint \"src/**/*.scss\"",
    "test": "npm run write:env -s && ng test",
    "test:ci": "npm run write:env -s && npm run lint -s && ng test --watch=false --configuration=ci",
    "e2e": "npm run write:env -s && playwright test",
    "e2e:ui": "npm run write:env -s && playwright test --ui",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/en-US.json --format=json --clean --sort",
    "docs": "hads ./docs -o",
    "write:env": "ngx-scripts env npm_package_version",
    "prettier": "prettier --write \"./src/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./src/**/*.{ts,js,html,scss}\"",
    "postinstall": "npm run prettier -s && husky install",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular/animations": "~21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "~21.2.22",
    "@angular/compiler": "~21.2.22",
    "@angular/core": "~21.2.22",
    "@angular/forms": "~21.2.22",
    "@angular/localize": "~21.2.22",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "~21.2.22",
    "@angular/platform-browser-dynamic": "~21.2.22",
    "@angular/router": "~21.2.22",
    "@angular/service-worker": "~21.2.22",
    "@ngx-translate/core": "^14.0.0",
    "@vendure/ngx-translate-extract": "^10.2.0",
    "lodash": "^4.17.20",
    "material-design-icons-iconfont": "^6.1.0",
    "moment": "^2.29.4",
    "ngx-mat-select-search": "^9.0.0",
    "rxjs": "^7.5.0",
    "swiper": "^14.2.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.22",
    "@angular/cli": "~21.2.22",
    "@angular/compiler-cli": "~21.2.22",
    "@angular/language-service": "~21.2.22",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@ngneat/until-destroy": "^9.0.0",
    "@ngx-rocket/scripts": "^5.2.2",
    "@playwright/test": "^1.55.0",
    "@types/lodash": "^4.14.184",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-cli-ghpages": "^2.0.0-beta.2",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "latest",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-plugin-prefer-arrow": "latest",
    "hads": "^3.0.0",
    "https-proxy-agent": "^5.0.0",
    "husky": "^8.0.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.5",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "stylelint": "~14.11.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recommended-scss": "~7.0.0",
    "stylelint-config-standard": "~28.0.0",
    "ts-node": "^10.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  }
}
